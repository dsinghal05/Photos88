<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="25" alignment="TOP_CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="Photos.view.LoginController"
      style="-fx-background-color: linear-gradient(from 0% 0% to 0% 100%, #d3d3d3, #87CEEB);">

    <padding>
        <Insets top="30" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Photos"
           style="-fx-font-size: 28px; -fx-font-weight: bold;" />

    <HBox spacing="10" alignment="CENTER">
        <Label text="Enter username:" />
        <TextField fx:id="usernameField" promptText="username" maxWidth="200"/>
    </HBox>

    <Button text="Enter" onAction="#usernameEntered" defaultButton="true"/>

</VBox>