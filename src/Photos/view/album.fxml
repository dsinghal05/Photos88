<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="Photos.view.AlbumController"
            prefWidth="900" prefHeight="600">

    <!-- 🔝 Top Info Bar -->
    <top>
        <VBox spacing="5" style="-fx-padding: 10;">
            <Label fx:id="albumTitleLabel" style="-fx-font-size: 18px;" />
            <Label fx:id="albumInfoLabel" />
        </VBox>
    </top>

    <!-- 📸 Photo Grid -->
    <center>
        <ScrollPane fitToWidth="true">
            <TilePane fx:id="photoTilePane"
                      hgap="10" vgap="10"
                      prefColumns="4"
                      style="-fx-padding: 10;" />
        </ScrollPane>
    </center>

    <!-- 🔽 Bottom Controls -->
    <bottom>
        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 10;">
            <Button text="Add Photo" onAction="#handleAddPhoto"/>
            <Button text="Back" onAction="#handleBack"/>
        </HBox>
    </bottom>

</BorderPane>